<Window x:Class="StockMovementAnalyzer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stock Movement Analyzer" Height="760" Width="1240" MinHeight="620" MinWidth="940"
        Background="#F5F5F2" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#146C5A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/></Style>
        <Style x:Key="TechnicalCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding TechnicalBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PriceCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{Binding PriceFlashBrush}"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OvernightCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding OvernightBrush}"/>
            <Setter Property="Background" Value="{Binding OvernightFlashBrush}"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PreMarketCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding PreMarketBrush}"/>
            <Setter Property="Background" Value="{Binding PreMarketFlashBrush}"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AfterHoursCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{Binding AfterHoursFlashBrush}"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ModelCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding ModelBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Stock Movement Analyzer" FontFamily="Georgia" FontWeight="Bold" FontSize="30" Foreground="#17332D"/>
                <TextBlock Text="Live evidence, deterministic projections, and optional free local-model review" Foreground="#52625E" Margin="0,4,0,12"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E3EFEA" Padding="12,8" CornerRadius="4" VerticalAlignment="Top">
                <TextBlock Text="{Binding Status}" Foreground="#17332D"/>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8DDD9" BorderThickness="1" Padding="12" CornerRadius="5" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel>
                    <TextBox Width="130" Text="{Binding NewSymbol, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ticker symbol"/>
                    <Button Content="Add symbol" Click="AddSymbol_Click"/>
                    <ComboBox Width="115" ItemsSource="{Binding Horizons}" SelectedItem="{Binding SelectedHorizon}"/>
                    <Button Content="Refresh all" Click="Refresh_Click"/>
                    <Button Content="Delete selected" Background="#9B3D35" Click="Delete_Click"/>
                    <Button Content="Clear" Background="#6A5250" Click="Clear_Click"/>
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <CheckBox Content="Use free local Ollama model" IsChecked="{Binding UseLocalModel}" VerticalAlignment="Center" Margin="6"/>
                    <ComboBox Width="245" IsEditable="True" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding EndpointOptions}" ToolTip="Ollama endpoint"/>
                    <Button Content="Find endpoints" Click="FindEndpoints_Click"/>
                    <ComboBox Width="210" IsEditable="True" Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ModelOptions}" ToolTip="Installed or example model"/>
                    <Button Content="Discover models" Click="DiscoverModels_Click"/>
                    <TextBox Width="260" Text="{Binding FinnhubApiKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional Finnhub API key for quote fallback"/>
                    <TextBlock Text="Models run locally; no API key or paid endpoint." VerticalAlignment="Center" Foreground="#52625E" Margin="10,0"/>
                </WrapPanel>
                <StackPanel Grid.Row="2" Margin="6,8,0,0">
                    <TextBlock Foreground="#52625E" TextWrapping="Wrap"
                               Text="Endpoint examples: http://127.0.0.1:11434 (same PC), http://localhost:11434, or http://[this-PC-LAN-IP]:11434 for Android on the same Wi-Fi. Click Find endpoints to auto-populate this machine's options."/>
                    <TextBlock Foreground="#52625E" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Model options: choose any discovered installed model, or enter an example ID such as qwen3:4b, qwen3:8b, llama3.1:8b, mistral:7b, or phi4:latest after pulling it with Ollama. Entering gpt-5.3-codex maps to qwen3:8b for local execution."/>
                    <TextBlock Foreground="#52625E" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Finnhub key is optional and only used as a quote fallback when Yahoo is missing current price/timestamp."/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="560"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*" MinWidth="330"/></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="White"
                      BorderBrush="#D8DDD9" AlternatingRowBackground="#F7FAF8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" IsReadOnly="True" Width="75"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" ElementStyle="{StaticResource PriceCell}" IsReadOnly="True" Width="88"/>
                    <DataGridTextColumn Header="Last overnight" Binding="{Binding OvernightGrid}" ElementStyle="{StaticResource OvernightCell}" IsReadOnly="True" Width="180"/>
                    <DataGridTextColumn Header="Pre-market" Binding="{Binding PreMarketGrid}" ElementStyle="{StaticResource PreMarketCell}" IsReadOnly="True" Width="180"/>
                    <DataGridTextColumn Header="Last after-hours" Binding="{Binding AfterHoursGrid}" ElementStyle="{StaticResource AfterHoursCell}" IsReadOnly="True" Width="180"/>
                    <DataGridTextColumn Header="Technical" Binding="{Binding Technical}" ElementStyle="{StaticResource TechnicalCell}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="Projected range" Binding="{Binding TechnicalRange}" ElementStyle="{StaticResource TechnicalCell}" IsReadOnly="True" Width="135"/>
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" ElementStyle="{StaticResource TechnicalCell}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Local model" Binding="{Binding ModelResult}" ElementStyle="{StaticResource ModelCell}" IsReadOnly="True" Width="135"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                    <DataGridTextColumn Header="Avg cost" Binding="{Binding AverageCost, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="White" BorderBrush="#D8DDD9" BorderThickness="1" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel DataContext="{Binding SelectedRow}">
                        <TextBlock Text="{Binding Symbol, FallbackValue=Select a stock}" FontFamily="Georgia" FontSize="24" FontWeight="Bold" Foreground="#17332D"/>
                        <TextBlock Text="Click any row to inspect its complete analysis." Foreground="#52625E" Margin="0,2,0,14"/>

                        <TextBlock Text="Technical action" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TechnicalSummary}" Foreground="{Binding TechnicalBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Source and validation" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SourceDetails}" Foreground="#3F3F45" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Indicators" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding IndicatorDetails}" Foreground="#3F3F45" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Signal weights" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SignalDetails}" Foreground="#3F3F45" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="News research" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NewsDetails}" Foreground="#3F3F45" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Free local model review" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ModelDetails}" Foreground="{Binding ModelBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Gaps and limitations" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WarningDetails}" Foreground="#3F3F45" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Final reason" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FinalReason}" Foreground="#3F3F45" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="Yahoo Finance public data is best-effort. Predictions are probabilistic and not financial advice. Local-model output is bounded and never replaces failed data validation."
                   Foreground="#5E6563" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
